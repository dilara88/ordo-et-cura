@{ ViewData["Title"] = "Customer onboarding demo"; }
        <section class="hero" aria-labelledby="page-title">
            <div class="wrap hero-inner">
                <div>
                    <p class="eyebrow">Customer onboarding demo</p>
                    <h1 id="page-title">From kickoff to handover</h1>
                    <p class="intro">Ordo et Cura is a fictional platform that helps B2B teams and their customers coordinate onboarding tasks, responsibilities, and approvals in one shared project.</p>
                    <a class="button" asp-controller="Workspace" asp-action="Index">Explore demo workspace</a>
                </div>
                <img class="logo" src="~/logo.png" alt="Ordo et Cura logo" width="1254" height="1254">
            </div>
        </section>

        <section class="wrap questions" id="questions" aria-labelledby="questions-title">
            <div>
                <p class="eyebrow">Support examples</p>
                <h2 id="questions-title">Onboarding questions</h2>
                <p>Open a question to see how support might help in a typical onboarding scenario.</p>
            </div>
            <div>
                <details>
                    <summary>How do I get access to the workspace?</summary>
                    <p>Your Ordo et Cura administrator creates your account and links it to your company. Sign in with the email address and password they give you. After five failed attempts, sign-in is paused for five minutes.</p>
                </details>
                <details>
                    <summary>Why can't I see my project after signing in?</summary>
                    <p>You see every project that belongs to your company. If a project is missing, ask your Ordo et Cura administrator to check that your account is active and linked to the right company.</p>
                </details>
                <details>
                    <summary>Why is training blocked after the configuration task is done?</summary>
                    <p>Training starts only after the assigned approver signs off on configuration. The project checklist shows whether approval is still pending. If it is, follow up with your company's assigned approver.</p>
                </details>
            </div>
        </section>

