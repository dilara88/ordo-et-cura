@model BackOfficeView
<section class="wrap app-section">
    <h1>Ordo et Cura Back Office</h1>
    <div class="workspace-panel data-panel">
        <h2>Test accounts</h2>
        <table>
            <thead><tr><th scope="col">Email</th><th scope="col">Company</th><th scope="col">Role</th></tr></thead>
            <tbody>
            @foreach (var account in Model.Accounts)
            {
                <tr><td>@account.Email</td><td>@account.Company</td><td>@account.Role</td></tr>
            }
            </tbody>
        </table>
    </div>
    <div class="workspace-panel data-panel">
        <h2>Projects</h2>
        <table>
            <thead><tr><th scope="col">Workspace</th><th scope="col">Company</th><th scope="col">Plan</th><th scope="col">Approver</th><th scope="col">Approval</th></tr></thead>
            <tbody>
            @foreach (var project in Model.Projects)
            {
                <tr><td>@project.Workspace</td><td>@project.Company</td><td>@project.Plan</td><td>@project.Approver</td><td>@(project.ApprovedAt.HasValue ? "Approved" : "Pending")</td></tr>
            }
            </tbody>
        </table>
    </div>
</section>
