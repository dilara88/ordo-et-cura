@model LoginInput
<section class="wrap app-section">
    <div class="workspace-panel login-panel">
        <h1>Sign in</h1>
        <form method="post" asp-action="Login" class="login-form">
            <div asp-validation-summary="All" role="alert"></div>
            <input asp-for="ReturnUrl" type="hidden">
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="username" required>
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" required>
            <button class="button" type="submit">Sign in</button>
        </form>
    </div>
</section>
